{
    "compilerOptions": {
        "target": "es2017",
        "module": "esnext",
        "lib": ["es2017", "dom"],
        "declaration": true,
        "declarationDir": "dist/types/src",
        "outDir": "dist",
        "strict": true,
        "moduleResolution": "node",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "**/*.test.ts"]
}